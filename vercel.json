{
  "version": 2,
  "builds": [
    {
      "src": "/index.html",
      "use": "@vercel/static"
    },
    {
      "src": "/dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "/devices.html",
      "use": "@vercel/static"
    },
    {
      "src": "/login.html",
      "use": "@vercel/static"
    },
    {
      "src": "/styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "/styles-landing.css",
      "use": "@vercel/static"
    },
    {
      "src": "/app.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}